# Puerto donde corre la API
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Motor de base de datos: sqlite | postgres
# Arrancamos con sqlite (cero instalación). El día que quieran pasar a
# PostgreSQL, cambian esta variable a "postgres" y completan DATABASE_URL:
# la capa src/config/db.js ya está preparada para elegir el cliente de knex
# según este valor, sin tocar el resto del código.
DB_CLIENT=sqlite

# Usado solo si DB_CLIENT=sqlite. Ruta del archivo de base de datos.
SQLITE_FILE=./data/escuela.sqlite3

# Usado solo si DB_CLIENT=postgres
DATABASE_URL=postgresql://usuario:password@localhost:5432/escuela_db

# Secreto para firmar los JWT de sesión (cambiar en producción por uno largo y random)
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# URL del frontend, para configurar CORS
FRONTEND_URL=http://localhost:3500

# --- Mails (ver src/services/mail.service.js) ---
# Si dejás SMTP_HOST vacío, el motor arranca en MODO PRUEBA: crea sola una
# cuenta descartable de Ethereal (https://ethereal.email) y no manda mails
# reales — cada mail queda igual en la tabla mail_log con un link de
# preview, visible desde /admin-panel/mails → Registro. Para conectar un
# proveedor real, completá estas 4 variables (ejemplo con SendGrid, sirve
# igual para Resend, Amazon SES, o el SMTP de tu propio dominio):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Escuela Online
MAIL_FROM_EMAIL=no-responder@escuela-online.demo

# Apaga los 3 cron jobs de mails (recordatorio de turno, carrito
# abandonado, inactividad) sin tocar código. true por defecto.
JOBS_HABILITADOS=true

# --- Pagos reales (ver src/services/payments.service.js) ---
# Sin ninguna de estas variables, el checkout sigue funcionando en modo
# SIMULADO (aprueba al toque, no cobra nada real) — es el comportamiento
# de siempre, cero cambios para quien no configure nada acá. Se puede
# habilitar Mercado Pago, PayPal, los dos, o ninguno.

# Mercado Pago: Access Token y Public Key de tu cuenta (Panel de
# desarrolladores → Tus integraciones → credenciales de prueba o de
# producción). Con las de PRUEBA no se cobra nada real.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# PayPal: Client ID y Secret de tu app (developer.paypal.com → My Apps &
# Credentials). PAYPAL_MODE=sandbox usa cuentas de prueba (nada real se
# cobra); PAYPAL_MODE=live cobra de verdad.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Integraciones IA (ver src/services/aiChat/, /integraciones-ia) ---
# Cada alumno carga su PROPIA API key de ChatGPT/Claude/Gemini desde la
# pestaña Vinculaciones — no hace falta ninguna variable acá para que
# funcione. Estas 3 son opcionales: solo hacen falta si un proveedor
# cambia el modelo por defecto y hay que apuntar a uno nuevo sin tocar
# código (ver config/aiProviders.js para los valores por defecto).
OPENAI_CHAT_MODEL=
ANTHROPIC_CHAT_MODEL=
GEMINI_CHAT_MODEL=

# --- Clases en vivo (ver src/realtime/liveClassSocket.js, JitsiRoom.jsx) ---
# Dominio del servidor de Jitsi Meet embebido en la sala de cada clase.
# meet.jit.si es el servidor público y gratuito de Jitsi — no requiere
# ninguna cuenta ni configuración para arrancar. Para tener salas propias
# (self-hosted, más control), cambiá esto al dominio de tu propio servidor
# de Jitsi — no hace falta tocar código, ni backend ni frontend.
JITSI_DOMAIN=meet.jit.si
